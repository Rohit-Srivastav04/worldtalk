{
  "name": "worldtalk/platform",
  "description": "WorldTalk — global real-time public chat platform",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "vlucas/phpdotenv": "^5.6",
    "workerman/workerman": "^4.1",
    "predis/predis": "^2.2",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "WorldTalk\\": "app/"
    },
    "files": [
      "app/Helpers/helpers.php",
      "app/Helpers/sql.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WorldTalk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:8080 -t public",
    "ws": "php websocket/server.php start",
    "migrate": "php scripts/migrate.php",
    "test": "phpunit"
  }
}
