APP_NAME=WorldTalk
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=change-me-to-a-long-random-string-32chars

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worldtalk
DB_USERNAME=worldtalk
DB_PASSWORD=worldtalk_secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=worldtalk:

WS_HOST=0.0.0.0
WS_PORT=2346
WS_PUBLIC_URL=ws://localhost:2346
WS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

SESSION_NAME=wt_session
SESSION_LIFETIME=1209600
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

MAIL_FROM=noreply@worldtalk.local
MAIL_FROM_NAME=WorldTalk

RATE_LIMIT_MESSAGES_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=10
MAX_MESSAGE_LENGTH=500

ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=

ADMIN_EMAIL=admin@worldtalk.local
ADMIN_PASSWORD=ChangeThisAdminPass1!
